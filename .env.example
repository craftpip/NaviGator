# Environment Configuration Template
# ================================
# Copy this file to .env and adjust values as needed.
# The defaults in docker-compose.yml cover everything else —
# a fresh `docker compose up -d` works with no .env at all.
#
# For the full reference of every supported variable, see .env.example.full

HEADLESS=true               # Run browser without UI (true/false)
ENABLE_HTTP_MCP=1           # Enable Streamable HTTP transport at /mcp
MCP_API_PORT=3000            # Port for HTTP API (serves /console, /health, /mcp, /download)
BROWSER_BACKEND=cloakbrowser # "cloakbrowser" (default), "lightpanda", or "chromium"
DISABLE_TOOLS=               # MCP tools to disable, comma-separated. Empty = all enabled. e.g. web_page_ascii,DOM.getCompactHTML
ENABLE_WEB_CONSOLE=1         # Serve the live management console at /console (same port as MCP)
ENABLE_VNC=1                 # Start the Xvfb display stack at boot (noVNC at :NOVNC_PORT)
NOVNC_PORT=7900              # Published noVNC web port (http://localhost:7900/vnc.html)
DEFAULT_EXTRACT_FORMAT=      # Extractor for pages with no domain hint: readability_to_markdown (default), html_to_markdown, html, text, table, table_json, table_csv, or an AI model id
DEFAULT_EXTRACT_STABILIZE_STRATEGY= # Stabilization for unmatched pages: network_idle (default), content_idle, mutation, none. Empty = inherit the global STABILIZE_STRATEGY
DEFAULT_EXTRACT_WAIT_FOR_SELECTOR=  # CSS selectors (comma-separated) to wait for before extracting unmatched pages
DEFAULT_EXTRACT_WAIT_FOR_CONTENT=   # CSS selectors (comma-separated) to wait for content in before extracting unmatched pages
