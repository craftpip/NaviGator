[
  {
    "domain": "github.com",
    "pathPattern": "/*",
    "pageType": "profile",
    "comment": "User profile page — sidebar (name, bio, stats, orgs) + pinned repos + contribution graph.",
    "waitForSelector": "turbo-frame#user-profile-frame",
    "preferReadability": false,
    "content": {
      "sections": [
        {
          "selector": "h1.vcard-names",
          "label": "Name",
          "priority": "high"
        },
        {
          "selector": "div.js-profile-editable-area",
          "label": "Profile",
          "priority": "high"
        },
        {
          "selector": "ol.js-pinned-items-reorder-list",
          "label": "Pinned Repositories",
          "priority": "high"
        }
      ]
    }
  },
  {
    "domain": "github.com",
    "pathPattern": "/*/*",
    "pageType": "repo",
    "comment": "Repository page — README, file list, metadata. README is in a markdown-body element.",
    "waitForSelector": "[class*=\"markdown-body\"]",
    "content": {
      "sections": [
        {
          "selector": "[class*=\"markdown-body\"]",
          "label": "README",
          "priority": "high"
        }
      ]
    }
  },
  {
    "domain": "github.com",
    "pathPattern": "/*/*/issues",
    "pageType": "issues",
    "comment": "Issue list page — each issue row has title, status, number, author.",
    "waitForSelector": "turbo-frame#repo-content-turbo-frame",
    "content": {
      "sections": [
        {
          "selector": "li[role=\"listitem\"]",
          "label": "Issues",
          "priority": "high"
        }
      ]
    }
  },
  {
    "domain": "github.com",
    "pathPattern": "/*/*/pulls",
    "pageType": "prs",
    "comment": "Pull request list page — each PR row has title, status, reviewers.",
    "waitForSelector": "turbo-frame#repo-content-turbo-frame",
    "content": {
      "sections": [
        {
          "selector": "div.js-issue-row",
          "label": "Pull Requests",
          "priority": "high"
        }
      ]
    }
  },
  {
    "domain": "github.com",
    "pathPattern": "/*/*/issues/*",
    "pageType": "issue-detail",
    "comment": "Issue detail page — description, comments.",
    "waitForSelector": ".markdown-body",
    "preferReadability": false,
    "content": {
      "sections": [
        {
          "selector": ".markdown-body",
          "label": "Issue",
          "priority": "high"
        }
      ]
    }
  },
  {
    "domain": "github.com",
    "pathPattern": "/*/*/pull/*",
    "pageType": "pr-detail",
    "comment": "Pull request detail page — description, diff, comments.",
    "waitForSelector": ".markdown-body",
    "preferReadability": false,
    "content": {
      "sections": [
        {
          "selector": ".markdown-body",
          "label": "PR",
          "priority": "high"
        }
      ]
    }
  },
  {
    "domain": "10.69.1.164",
    "pathPattern": "/**",
    "comment": "",
    "testUrls": [
      "http://10.69.1.164:32768/chaos/",
      "http://10.69.1.164:32768/table/"
    ],
    "waitForSelector": [],
    "skipSelectors": [],
    "preferReadability": true,
    "contentSelectors": []
  }
]
