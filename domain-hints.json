[
  {
    "domain": "github.com",
    "pathPattern": "/*",
    "pageType": "profile",
    "comment": "User profile page — sidebar (name, bio, stats, orgs) + pinned repos + contribution graph.",
    "flow": [
      {
        "action": "wait",
        "selector": "turbo-frame#user-profile-frame",
        "timeoutMs": 10000
      },
      {
        "action": "extract",
        "label": "profile",
        "content": {
          "blocks": [
            {
              "selector": "h1.vcard-names",
              "label": "Name",
              "priority": "high",
              "format": "html_to_markdown"
            },
            {
              "selector": "div.js-profile-editable-area",
              "label": "Profile",
              "priority": "high",
              "format": "html_to_markdown"
            },
            {
              "selector": "ol.js-pinned-items-reorder-list",
              "label": "Pinned Repositories",
              "priority": "high",
              "format": "html_to_markdown"
            }
          ]
        }
      }
    ]
  },
  {
    "domain": "github.com",
    "pathPattern": "/*/*",
    "pageType": "repo",
    "comment": "Repository page — README, file list, metadata. README is in a markdown-body element.",
    "flow": [
      {
        "action": "wait",
        "selector": "[class*=\"markdown-body\"]",
        "timeoutMs": 10000
      },
      {
        "action": "extract",
        "label": "repo",
        "content": {
          "blocks": [
            {
              "selector": "[class*=\"markdown-body\"]",
              "label": "README",
              "priority": "high",
              "format": "readability_to_markdown"
            }
          ]
        }
      }
    ]
  },
  {
    "domain": "github.com",
    "pathPattern": "/*/*/issues",
    "pageType": "issues",
    "comment": "Issue list page — each issue row has title, status, number, author.",
    "flow": [
      {
        "action": "wait",
        "selector": "turbo-frame#repo-content-turbo-frame",
        "timeoutMs": 10000
      },
      {
        "action": "extract",
        "label": "issues",
        "content": {
          "blocks": [
            {
              "selector": "li[role=\"listitem\"]",
              "label": "Issues",
              "priority": "high",
              "format": "readability_to_markdown"
            }
          ]
        }
      }
    ]
  },
  {
    "domain": "github.com",
    "pathPattern": "/*/*/pulls",
    "pageType": "prs",
    "comment": "Pull request list page — each PR row has title, status, reviewers.",
    "flow": [
      {
        "action": "wait",
        "selector": "turbo-frame#repo-content-turbo-frame",
        "timeoutMs": 10000
      },
      {
        "action": "extract",
        "label": "prs",
        "content": {
          "blocks": [
            {
              "selector": "div.js-issue-row",
              "label": "Pull Requests",
              "priority": "high",
              "format": "readability_to_markdown"
            }
          ]
        }
      }
    ]
  },
  {
    "domain": "github.com",
    "pathPattern": "/*/*/issues/*",
    "pageType": "issue-detail",
    "comment": "Issue detail page — description, comments.",
    "flow": [
      {
        "action": "wait",
        "selector": ".markdown-body",
        "timeoutMs": 10000
      },
      {
        "action": "extract",
        "label": "issue-detail",
        "content": {
          "blocks": [
            {
              "selector": ".markdown-body",
              "label": "Issue",
              "priority": "high",
              "format": "html_to_markdown"
            }
          ]
        }
      }
    ]
  },
  {
    "domain": "github.com",
    "pathPattern": "/*/*/pull/*",
    "pageType": "pr-detail",
    "comment": "Pull request detail page — description, diff, comments.",
    "flow": [
      {
        "action": "wait",
        "selector": ".markdown-body",
        "timeoutMs": 10000
      },
      {
        "action": "extract",
        "label": "pr-detail",
        "content": {
          "blocks": [
            {
              "selector": ".markdown-body",
              "label": "PR",
              "priority": "high",
              "format": "html_to_markdown"
            }
          ]
        }
      }
    ]
  },
  {
    "domain": "10.69.1.164",
    "pathPattern": "/**",
    "pageType": "chaos-article",
    "comment": "ChaosHub fake article — sections + comments list. Content randomized per visit; ignore fake bot-check/popup.",
    "testUrls": [
      "http://10.69.1.164:32768/table/"
    ],
    "default": {
      "waitForSelector": [],
      "stabilizeStrategy": "",
      "waitForContent": [],
      "skipSelectors": [],
      "format": "html_to_markdown"
    }
  },
  {
    "domain": "nseindia.com",
    "pathPattern": "/option-chain",
    "comment": "",
    "testUrls": [
      "https://www.nseindia.com/option-chain"
    ],
    "flow": [
      {
        "action": "extract",
        "label": "",
        "content": {
          "blocks": [
            {
              "selector": "#optionChainTable-indices",
              "label": "",
              "priority": "high",
              "format": "table"
            }
          ]
        }
      }
    ],
    "flowOptions": {
      "continueOnEmptyExtract": false
    }
  }
]
