    "domain": "stackoverflow.com",
    "pathPattern": "/questions/**",
    "pageType": "article",
    "comment": "QA page with question and answers. Cloudflare protection on some pages.",
    "testUrls": [
      "https://stackoverflow.com/questions/6818875/new-line-on-php-cli",
      "https://stackoverflow.com/questions/11227809/why-is-processing-a-sorted-array-faster-than-processing-an-unsorted-array"
    ],
    "waitForSelector": "#question .js-post-body",
    "preferReadability": false,
    "flags": { "botProtected": true },
    "content": {
      "sections": [
        {
          "selector": "#question",
          "label": "Question",
          "priority": "high",
          "fields": [
            { "selector": ".js-vote-count", "label": "Votes", "format": "text" },
            { "selector": ".js-post-body", "label": "Content", "format": "markdown" },
            { "selector": "[id^=\"follow-ups-list-\"] [itemprop=\"text\"]", "label": "Comments", "format": "list" }
          ]
        },
        {
          "selector": ".answer",
          "label": "Answers",
          "itemLabel": "Answer",
          "priority": "high",
          "fields": [
            { "selector": ".js-vote-count", "label": "Votes", "format": "text" },
