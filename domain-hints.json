  {
    "domain": "en.wikipedia.org",
    "pathPattern": "/wiki/**",
    "pageType": "article",
    "comment": "Standard encyclopedia article with infobox and references. Skip navbox tables.",
    "skipSelectors": [".navbox", ".navbox-styles", ".mw-empty-elt"],
    "tableExtraction": "content",
    "content": {
      "sections": [
        { "selector": "main#content", "label": "Article", "priority": "high" }
      ]
    }
  },
  {
    "domain": "github.com",
    "pathPattern": "/*",
    "pageType": "profile",
    "comment": "User profile page — sidebar (name, bio, stats, orgs) + pinned repos + contribution graph.",
    "waitForSelector": "turbo-frame#user-profile-frame",
    "preferReadability": false,
    "content": {
      "sections": [
        { "selector": "h1.vcard-names", "label": "Name", "priority": "high" },
        { "selector": "div.js-profile-editable-area", "label": "Profile", "priority": "high" },
        { "selector": "ol.js-pinned-items-reorder-list", "label": "Pinned Repositories", "priority": "high" }
      ]
    }
  },
  {
    "domain": "github.com",
    "pathPattern": "/*/*",
